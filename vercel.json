{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": ".output",
  "functions": {
    "api/runs/sync.ts": { "maxDuration": 300 }
  },
  "crons": [{ "path": "/api/runs/sync", "schedule": "0 4 * * *" }],
  "redirects": [
    {
      "source": "/writing/helpful-tips-for-better-design-in-the-web",
      "destination": "/writing/tips-to-improve-your-product",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "tdm-reservation", "value": "1" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Vary", "value": "Origin" },
        { "key": "Access-Control-Allow-Origin", "value": "https://floriankiem.com" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" }
      ]
    }
  ]
}
